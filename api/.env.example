# SkillExchange API — Local Development Environment
# KHÔNG commit file này lên Git!

# Server
PORT=8080
KTOR_ENV=development

# Supabase Database (lấy từ Supabase → Settings → Database → URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_CREATE_TABLES=false  # Set true chỉ khi dùng DB local mới cần SchemaUtils tạo bảng tự động (DEC-007)

# JWT (tự đặt bất kỳ chuỗi bí mật nào, dài ít nhất 32 ký tự)
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_ISSUER=skillexchange-api
JWT_AUDIENCE=skillexchange-app

# Supabase API (dùng để gửi OTP email qua Supabase Auth)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloudflare R2 (Object storage cho avatar và uploads - DEC-009)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

